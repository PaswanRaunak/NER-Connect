# Copy to .env and fill in what you have. Everything is optional:
# without keys the prototype runs fully offline on the built-in
# risk-weighted graph engine.

# OpenRouteService (free key at https://openrouteservice.org/dev/)
# Enables real-network fastest-route validation with avoid-polygons
# around blocked segments.
ORS_API_KEY=your_openrouteservice_api_key_here
ORS_PROFILE=driving-hgv
